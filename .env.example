# CONEKTA // ETHERNIUM PERSONAL
# Copy to .env.local only when the portable defaults are insufficient.

# Local Conekta UI ledger and state. Defaults to <CONEKTA>/runtime.
#CONEKTA_RUNTIME_ROOT=./runtime

# Sole cognitive authority. The URL must remain loopback.
CONEKTA_FRUGAL_ENABLED=true
CONEKTA_FRUGAL_BASE_URL=http://127.0.0.1:3369
CONEKTA_FRUGAL_TIMEOUT_MS=45000

# Portable sibling discovery. Defaults to ../FRUGAL.
#CONEKTA_FRUGAL_ROOT=../FRUGAL

# Optional server-held override. Never commit a real value. When omitted,
# Conekta reads <FRUGAL>/04_MEMORY/continuity/api_token at runtime.
CONEKTA_FRUGAL_API_TOKEN=

# Optional bearer for non-browser/headless mutations into Conekta.
# Same-origin browser requests do not need it.
CONEKTA_API_TOKEN=
