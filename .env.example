# CONTINUITY LEGACY // LOCAL CHAT BRIDGE
# Copy this file to `.env.local` on the target machine.

# RUNTIME ROOT
# Where CONEKTA looks for STATE.json / EVENT_CHAIN.jsonl and stores its own
# runtime state. Defaults to `<repo>/runtime`. Point it at a real Continuity
# Legacy checkout to drive the dashboard from live data.
#CONEKTA_RUNTIME_ROOT=D:/path/to/continuity-legacy
# Where the AUDIT / CRYSTALLIZE / SEAL python scripts live.
# Defaults to `<runtime root>/scripts`. Without them the actions answer
# 501 SCRIPT_NOT_AVAILABLE instead of failing.
#CONEKTA_SCRIPTS_DIR=D:/path/to/continuity-legacy/.github/scripts

# SECURITY: filesystem APIs accept loopback requests only by default.
# Enabling remote access requires authentication and a trusted reverse proxy.
#CONEKTA_ALLOW_REMOTE_FILESYSTEM=false

# Which chat backend should the dashboard use?
# Supported: frugal | openclaw | ollama | moltbot
CONTINUITY_CHAT_PROVIDER=frugal

# ETHERNIUM FRUGAL (local cognitive kernel — `npm run api` inside its repo)
CONTINUITY_FRUGAL_ENABLED=true
CONTINUITY_FRUGAL_BASE_URL=http://127.0.0.1:3369
CONTINUITY_FRUGAL_TIMEOUT_MS=45000

# OLLAMA
CONTINUITY_OLLAMA_ENABLED=true
CONTINUITY_OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTINUITY_OLLAMA_MODEL=llama3.1
CONTINUITY_OLLAMA_TIMEOUT_MS=45000

# OPENCLAW
CONTINUITY_OPENCLAW_ENABLED=false
CONTINUITY_OPENCLAW_BASE_URL=http://127.0.0.1:3001
CONTINUITY_OPENCLAW_API_KEY=
CONTINUITY_OPENCLAW_TIMEOUT_MS=45000

# MOLTBOT
CONTINUITY_MOLTBOT_ENABLED=false
CONTINUITY_MOLTBOT_BASE_URL=http://127.0.0.1:3002
CONTINUITY_MOLTBOT_API_KEY=
CONTINUITY_MOLTBOT_TIMEOUT_MS=45000
