# CONTINUITY LEGACY // LOCAL BRIDGE
# Copy this file to `.env.local` on the target machine.

# RUNTIME ROOT
# Where CONEKTA looks for runtime artifacts and stores its own runtime state.
# Leave empty to use <this checkout>/runtime. Otherwise provide a path that is
# valid on the deployment machine; never commit a machine-specific value.
#CONEKTA_RUNTIME_ROOT=
#CONEKTA_SCRIPTS_DIR=

# SECURITY: filesystem APIs accept loopback requests only by default.
#CONEKTA_ALLOW_REMOTE_FILESYSTEM=false

# ETHERNIUM FRUGAL is the sole cognitive authority. CONEKTA remains a visual
# client and never stores the bearer token in browser-visible code.
CONTINUITY_FRUGAL_ENABLED=true
CONEKTA_FRUGAL_BASE_URL=http://127.0.0.1:3369
CONTINUITY_FRUGAL_TIMEOUT_MS=45000

# Preferred: use FRUGAL's local api_token file. If the repos are not siblings,
# point this to the ETHERNIUM-FRUGAL-by-Ethernium checkout.
#CONEKTA_FRUGAL_ROOT=
# Alternative for deployments: inject the token into the server environment.
#CONEKTA_FRUGAL_API_TOKEN=

# Optional token for non-browser clients that mutate CONEKTA APIs.
# Same-origin browser mutations are accepted without this value.
#CONEKTA_API_TOKEN=
